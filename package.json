{
  "name": "@rolster/rollup",
  "version": "3.0.0",
  "type": "module",
  "description": "Package containing the basic definitions for handling data types.",
  "license": "MIT",
  "author": "Rolster Technology <rolster.developments@gmail.com>",
  "contributors": [
    {
      "name": "Daniel Andrés Castillo Pedroza",
      "email": "ing.dacastillop@gmail.com"
    }
  ],
  "types": "./index.d.ts",
  "bin": {
    "rolster-rollup": "./bin/rolster-rollup.js"
  },
  "main": "./index.cjs",
  "module": "./index.esm.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "node": {
        "require": "./index.cjs",
        "import": "./index.esm.js"
      },
      "import": "./index.esm.js"
    }
  },
  "files": [
    "bin/rolster-rollup.js",
    "index.cjs",
    "index.cjs.map",
    "index.esm.js",
    "index.esm.js.map",
    "index.d.ts"
  ],
  "scripts": {
    "prettier": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "rollup -c rollup.config.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "rollup": "^4.61.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.64.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rolster-developments/typescript-rollup.git"
  },
  "keywords": [
    "rolster",
    "typescript",
    "rollup"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  }
}
